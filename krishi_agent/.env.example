# Copy this file to .env and fill in as you go.
# Leave MOCK_MODE=true to run the whole pipeline for free, offline, no signup needed.

MOCK_MODE=true

# --- Weather (only needed once MOCK_MODE=false) ---
# Free key: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Mandi prices (data.gov.in Agmarknet resource) ---
DATA_GOV_API_KEY=
AGMARKNET_RESOURCE_ID=

# --- Messaging (only needed once MOCK_MODE=false) ---
# Free trial + WhatsApp sandbox: https://www.twilio.com/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
